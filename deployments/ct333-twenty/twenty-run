#!/usr/bin/env bash
set -euo pipefail

readonly TOKEN_FILE="${BWS_TOKEN_FILE:-/etc/bitwarden-sm/product-apps-runtime-readonly.access-token}"
readonly PROJECT_ID=e6c761f9-7a4d-45a4-a780-b4860116e943
readonly COMPOSE_DIR=/opt/twenty/deployments/ct333-twenty
readonly METRICS_ROLE_SCRIPT="$COMPOSE_DIR/provision-crm-metrics-role.sh"

usage() {
  echo "usage: twenty-run {config|up|provision-metrics-role|pull|ps|logs|down}" >&2
  echo "       up, provision-metrics-role, and down take no extra arguments" >&2
}

# up and down are the two verbs that change what is running, and one forwarded
# flag turns either into an outage: `up --force-recreate` replaces healthy
# containers, `down -v` deletes the db-data volume the CRM lives on. Refuse
# extras here, before the runtime token is read and before bws or docker runs.
require_no_extra_args() {
  local action="$1"
  shift
  if (($# > 0)); then
    echo "twenty-run $action takes no extra arguments (got: $*)" >&2
    usage
    exit 2
  fi
}

load_bws_token() {
  if [[ ! -s "$TOKEN_FILE" ]]; then
    echo "missing Twenty runtime token: $TOKEN_FILE" >&2
    exit 1
  fi

  export BWS_ACCESS_TOKEN
  BWS_ACCESS_TOKEN="$(tr -d '\r\n[:blank:]' < "$TOKEN_FILE")"
}

run_compose() {
  load_bws_token

  /usr/local/bin/bws run --project-id "$PROJECT_ID" -- \
    env -u BWS_ACCESS_TOKEN \
    TAG=v2.20.0 \
    SERVER_URL=http://192.168.31.181:3000 \
    docker compose --project-directory "$COMPOSE_DIR" \
      -f "$COMPOSE_DIR/compose.yaml" "$@"
}

provision_metrics_role() {
  load_bws_token

  /usr/local/bin/bws run --project-id "$PROJECT_ID" -- \
    env -u BWS_ACCESS_TOKEN \
    bash "$METRICS_ROLE_SCRIPT"
}

main() {
  local action="${1:-up}"
  shift || true

  case "$action" in
    config) run_compose config --quiet ;;
    up)
      require_no_extra_args up "$@"
      run_compose up -d --remove-orphans
      ;;
    provision-metrics-role)
      require_no_extra_args provision-metrics-role "$@"
      provision_metrics_role
      ;;
    pull) run_compose pull "$@" ;;
    ps) run_compose ps "$@" ;;
    logs) run_compose logs "$@" ;;
    down)
      require_no_extra_args down "$@"
      run_compose down
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

# Dispatch only when executed. Sourcing defines the functions without running
# anything, which is how tests exercise the guard without a token or a daemon.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
